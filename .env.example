# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_SERVICE_ACCOUNT_EMAIL: The email of the Google Service Account with access to the Google Sheet.
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# GOOGLE_PRIVATE_KEY: The private key of the Google Service Account (enclose in quotes, substitute newlines with \n).
GOOGLE_PRIVATE_KEY=

# SPREADSHEET_ID: The unique ID of your Google Sheet.
SPREADSHEET_ID=

# GITHUB_PAT: Personal Access Token with 'repo' or 'workflow' / 'actions:write' permissions to trigger GitHub Actions.
GITHUB_PAT=

# PUBLISH_WEBHOOK_URL: Optional Webhook URL (Make.com / Zapier / Ayrshare / Buffer) to auto-post video reels.
PUBLISH_WEBHOOK_URL=

# GITHUB_REPO_OWNER: Owner of the repository containing the agents.
GITHUB_REPO_OWNER=DiegoCalleB

# GITHUB_REPO_NAME: Name of the repository containing the agents.
GITHUB_REPO_NAME=bakandeya-agent-manager

# OPENAI_API_KEY: Required for OpenAI Whisper-1 transcription services.
OPENAI_API_KEY=

# YOUTUBE_API_KEY: Optional key for the followers tracker script.
YOUTUBE_API_KEY=

# YOUTUBE_CHANNEL_ID: Optional YouTube channel ID for the followers tracker script.
YOUTUBE_CHANNEL_ID=

# SUPABASE_URL: Optional Supabase project URL for media & database migration.
SUPABASE_URL=

# SUPABASE_SERVICE_ROLE_KEY or SUPABASE_ANON_KEY: Key to authenticate with Supabase Storage.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# GOOGLE_PLACES_API_KEY: Optional key for Google Places API venue discovery.
GOOGLE_PLACES_API_KEY=

# SUPABASE_STORAGE_BUCKET: Bucket name for audio and image files (defaults to 'band-media').
SUPABASE_STORAGE_BUCKET=band-media

